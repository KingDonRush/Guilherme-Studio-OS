{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#07111f" },
        { "slug": "paper", "name": "Warm Paper", "color": "#f4efe5" },
        { "slug": "surface", "name": "Surface", "color": "#fbf8f0" },
        { "slug": "cyan", "name": "Cyan Accent", "color": "#13d8d2" },
        { "slug": "violet", "name": "Violet Accent", "color": "#5b35f2" },
        { "slug": "orange", "name": "Warm CTA", "color": "#e9720c" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Geist, Arial, sans-serif",
          "slug": "geist",
          "name": "Geist"
        },
        {
          "fontFamily": "JetBrains Mono, monospace",
          "slug": "jetbrains-mono",
          "name": "JetBrains Mono"
        }
      ]
    },
    "layout": {
      "contentSize": "980px",
      "wideSize": "1480px"
    }
  }
}
