# Ignore generated WordPress runtime by default.
*

# Keep local orchestration tracked.
!.gitignore
!.env.example
!.mcp.example.json
!README.md
!docker-compose.yml
!scripts/
!scripts/**
!exports/
exports/*
!exports/elementor/
!exports/elementor/**

# Keep wp-content structure tracked, but ignore generated runtime objects.
!wp-content/
wp-content/*
!wp-content/.gitkeep
!wp-content/plugins/
wp-content/plugins/*
!wp-content/plugins/.gitkeep
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/.gitkeep
!wp-content/themes/guilherme-portfolio/
!wp-content/themes/guilherme-portfolio/**
!wp-content/pages/
wp-content/pages/*
!wp-content/pages/.gitkeep
!wp-content/pages/simple-budget-case/
!wp-content/pages/simple-budget-case/**
!wp-content/mu-plugins/
wp-content/mu-plugins/*
!wp-content/mu-plugins/.gitkeep
!wp-content/mu-plugins/ai-local-elementor-mcp-guard.php
!wp-content/mu-plugins/ai-local-debug-display.php
!wp-content/mu-plugins/simple-budget-case-page.php

# Local secrets and dependencies.
.env
node_modules/
**/node_modules/
vendor/
*.log
.cache/
