    "auth_and_permissions",
    "frontend_contract",
    "integration_contract",
    "test_strategy",
    "security_review",
    "deployment_and_observability",
    "handoff"
  ],
  "acceptance_focus": [
    "API behavior is testable",
    "data model supports required workflows",
