{
  "preset": "full_stack_product",
  "use_when": "The project spans UI, backend, data, APIs, auth, permissions, integrations, deploy, or observability.",
  "required_context": [
    "functional scope",
    "users and permissions",
    "data entities",
    "external integrations",
    "deployment target"
  ],
  "phases": [
    "scope_contract",
    "architecture_contract",
    "data_model",
